{
  "manifest_version": 3,
  "name": "Fomo Lens",
  "version": "0.9.21",
  "description": "在 Fomo、GMGN 和 XXYY 查看代币叙事、Fomo 观点与持仓。支持 XXYY 新旧界面；读取 Fomo 数据需在同一浏览器登录。By @0xHogen",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://app.debot.ai/*",
    "https://debot.ai/*",
    "https://api.fxtwitter.com/*",
    "https://api.dexscreener.com/*",
    "https://api.github.com/*",
    "https://gmgn.ai/*",
    "https://fomo.family/*",
    "https://pro.xxyy.io/*",
    "https://www.xxyy.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fomo.family/*",
        "https://gmgn.ai/*",
        "https://pro.xxyy.io/*",
        "https://www.xxyy.io/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fomo Lens",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "author": "hogen (@0xHogen)",
  "homepage_url": "https://x.com/0xHogen",
  "key": ""
}
