{
  "manifest_version": 3,
  "name": "Fomo叙事镜",
  "version": "0.8.0",
  "description": "在 fomo.family 浏览代币时，把 DeBot 叙事、社区 thesis、持有人结构与来源推文聚成一张浮动卡片；可选接入你自己的分析源。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://app.debot.ai/*",
    "https://debot.ai/*",
    "https://api.fxtwitter.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fomo.family/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fomo叙事镜",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": ""
}